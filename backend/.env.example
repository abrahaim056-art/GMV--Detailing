# Copia este archivo como .env y llena tus datos. NO subas el .env a GitHub.

# Puerto donde corre la API
PORT=3000

# Conexión a MySQL (la misma que uses en Workbench)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=gmv_detailing

# Clave para firmar los tokens de sesión. Escribe una frase larga y propia.
JWT_SECRET=hola1234

# Orígenes que pueden llamar a la API (CORS), separados por coma.
# Si lo dejas vacío, se acepta cualquier origen (útil en desarrollo).
# Ejemplo: CORS_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
